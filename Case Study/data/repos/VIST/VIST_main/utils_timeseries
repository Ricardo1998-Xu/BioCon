def construct_df(estimated_mat, gene_loc,  test_time):
    time_for_df = np.array([])
    exp_for_df = np.array([])
    type_for_df = np.array([])
    # gene_loc = (gene_idx[gene_idx].index == gene_use)
    for i in range(estimated_mat.shape[1]):
        time_for_df = np.append(time_for_df, np.float32(test_time.detach().numpy()))
        exp_for_df = np.append(exp_for_df, estimated_mat[:,i, gene_loc].detach().numpy())
        type_for_df = np.append(type_for_df, np.repeat("generated", len(test_time)))


    
    df = pd.DataFrame(dict(time = time_for_df,
                           exp = exp_for_df,
                           TYPE = type_for_df,
                          )
                     )
    
    return df
