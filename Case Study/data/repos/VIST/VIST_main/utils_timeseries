def df_time_prediction(cell_type, model, anndata, test_time):
    NvarGenes = anndata.shape[1]

    AE = model
    cell_use = (anndata.obs.Idents == cell_type) #& (anndata.obs.time_by_rep == use_time)
    gene_exp = anndata.X[cell_use, :]
    if scipy.sparse.issparse(gene_exp):
        gene_exp = gene_exp.toarray()
    info = AE(torch.tensor(gene_exp).type(torch.float32))
    pred_time = AE.latent_mean_all[:,-1]
    lib_size = AE.l_sample


    #test_time = torch.tensor(torch.linspace(5,7,500))


    N_time = test_time.shape[0]
    estimated_gene_exp = torch.zeros(N_time, cell_use.sum(), NvarGenes)

    counter = 0
    for i in test_time:
        original_embedding = AE.latent_mean_all.clone()
        time_representation = AE.expandTime(torch.ones(cell_use.sum(),1) * i)
        latent_state = torch.hstack((original_embedding[:,0:-1], 
                                     time_representation
                                    )
                                    )

        estimated_gene_exp[counter,:,:] = AE.getGamma(latent_state) * lib_size

        counter += 1
        
    pred = np.array([])
    df_time = np.array([])
    for i in range(test_time.shape[0]):
        pred_time = AE.latentMean(estimated_gene_exp[i])[:,-1]
        pred = np.append(pred, pred_time.detach().numpy())
        df_time = np.append(df_time, np.repeat(test_time[i].detach().numpy(), pred_time.detach().numpy().shape[0]
                                              )
                           )

    df = pd.DataFrame(dict(time = df_time, prediction = pred))
    return df


